# GmailAI Assistant Environment Configuration (Optional)
# Most settings can be configured directly inside the app GUI in 'Settings & AI'.

# OpenAI API Key (Optional for Cloud AI fallback)
GMAILAI_OPENAI_API_KEY=

# Ollama Endpoint
GMAILAI_OLLAMA_URL=http://localhost:11434
GMAILAI_OLLAMA_MODEL=qwen2.5:latest

# App Theme (light | dark)
GMAILAI_UI_THEME=light

# Runtime mode (HYBRID | LOCAL_ONLY | CLOUD_ONLY | HEURISTIC)
GMAILAI_AI_MODE=HYBRID

# Set to 1 only when you want sample data and local-only mailbox actions
GMAILAI_DEMO_MODE=0
